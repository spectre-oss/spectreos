# Device-specific overrides after the shared SDM845 configuration.
# STMFTS is the Pixel 3 touchscreen, not either Poco F1 panel variant.
# Its code in the pinned tree also lacks GPIO consumer declarations.
CONFIG_TOUCHSCREEN_STMFTS=n
# This phone's EEPROM identifies the Sunny IMX363 / AK7374 actuator module.
# The local AK7375-family driver patch supplies its 10-bit variant.
CONFIG_VIDEO_AK7375=y
# Enable the PMI8998 rear dual-LED camera flash/torch controller (led-controller@d300).
CONFIG_LEDS_QCOM_FLASH=y
