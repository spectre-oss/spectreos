Subject: [LOCAL] Correct measured Sunny defects before preview reduction and still ISP

--- a/src/libcamera/software_isp/debayer_cpu.cpp
+++ b/src/libcamera/software_isp/debayer_cpu.cpp
@@ -12,6 +12,7 @@
 #include "debayer_cpu.h"
 #include "raw10-reduce.h"
 #include "raw10-denoise.h"
+#include "raw10-defects.h"
 
