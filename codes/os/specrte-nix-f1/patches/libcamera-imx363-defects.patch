@@ -490,6 +491,17 @@
 	denoisedRaw_.clear();
 	reducedRaw_.clear();
 	const char *fullSensor = utils::secure_getenv("SPECTRE_IMX363_FULL_SENSOR");
+	defectSourceStride_ = 0;
+	defectCorrectedRaw_.clear();
+	const char *defects = utils::secure_getenv("SPECTRE_IMX363_SUNNY_DEFECTS");
+	if (fullSensor && std::string(fullSensor) == "1" && defects &&
+	    std::string(defects) == "1" && sourceCfg.size == Size(4032, 3024) &&
+	    sourceCfg.pixelFormat == formats::SRGGB10_CSI2P && sourceCfg.stride >= 5040) {
