+		LOG(Debayer, Info) << "Sunny measured defect map enabled: "
+				   << spectre::sunnyDefects.size() << " pixels";
+	}
 	if (fullSensor && std::string(fullSensor) == "1" &&
 	    sourceCfg.size == Size(4032, 3024) && outputCfgs.size() == 1 &&
 	    sourceCfg.stride >= 4032 * 5 / 4) {
@@ -899,6 +911,17 @@
 	}
 
 	const uint8_t *source = in.planes()[0].data();
+	if (defectSourceStride_) {
+		if (!spectre::correctRaw10Defects(source, in.planes()[0].size(), defectSourceStride_,
+		                               defectCorrectedRaw_.data(), 4032, 3024,
+		                               spectre::sunnyDefects.data(), spectre::sunnyDefects.size())) {
+			metadata.status = FrameMetadata::FrameError;
+			outputBufferReady.emit(output);
+			inputBufferReady.emit(input);
+			return;
+		}
+		source = defectCorrectedRaw_.data();
+	}
 	if (reductionSourceStride_) {
 		if (in.planes()[0].size() < size_t(reductionSourceStride_) * 3024) {
 			metadata.status = FrameMetadata::FrameError;
