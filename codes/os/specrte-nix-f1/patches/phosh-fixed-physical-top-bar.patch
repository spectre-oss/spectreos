+/* Layer-shell uses integer logical coordinates. Round upward so coverage
+ * never falls below 90 physical pixels (30 logical pixels at scale 3). */
+int
+phosh_top_panel_get_bar_height (void)
+{
+  PhoshMonitor *monitor = phosh_shell_get_primary_monitor (phosh_shell_get_default ());
+  double scale = monitor ? MAX (1.0, phosh_monitor_get_fractional_scale (monitor)) : 1.0;
+
+  return (int) ceil (PHOSH_TOP_BAR_PHYSICAL_HEIGHT / scale);
 }
 
 
