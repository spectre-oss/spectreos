Subject: [PATCH] software_isp: seed first-frame ISP parameters from synchronous IPA defaults

Live Poco F1 first-frame crashes in DebayerCpu::updateGammaTable were traced
to SoftwareIsp::debayerParams_ being uninitialized before the first queued IPA
parameter update. Initialize the shared matrix and copy the initial IPA values.

--- a/src/ipa/simple/soft_simple.cpp
+++ b/src/ipa/simple/soft_simple.cpp
@@ -159,6 +159,7 @@
 		}
 
 		params_ = static_cast<DebayerParams *>(mem);
+		params_->combinedMatrix = Matrix<float, 3, 3>::identity();
 		params_->blackLevel = { { 0.0, 0.0, 0.0 } };
 		params_->gamma = 1.0 / algorithms::kDefaultGamma;
 		params_->contrastExp = 1.0;
--- a/src/libcamera/software_isp/software_isp.cpp
+++ b/src/libcamera/software_isp/software_isp.cpp
@@ -159,6 +159,9 @@
 		return;
 	}
 
+	/* Seed the first frame before asynchronous IPA updates arrive. */
+	debayerParams_ = *sharedParams_;
+
 	ipa_->setIspParams.connect(this, &SoftwareIsp::saveIspParams);
 	ipa_->metadataReady.connect(this,
 				    [this](uint32_t frame, const ControlList &metadata) {
