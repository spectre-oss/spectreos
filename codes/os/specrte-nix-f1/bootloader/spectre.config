CONFIG_DEFAULT_DEVICE_TREE="qcom/sdm845-xiaomi-beryllium-tianma"
# CONFIG_OF_UPSTREAM_BUILD_VENDOR is not set
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/spectre.env"
CONFIG_BOOTDELAY=-1
# CONFIG_BOOT_RETRY is not set
# CONFIG_RETRY_BOOTCMD is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_USB_ETHER=y
CONFIG_USB_ETH_RNDIS=y
CONFIG_USBNET_DEV_ADDR="02:53:50:46:31:01"
CONFIG_USBNET_HOST_ADDR="02:53:50:46:31:02"
CONFIG_NETCONSOLE=y
CONFIG_NET_LEGACY=y
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_PING=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_IMI=y
CONFIG_FIT=y
CONFIG_SHA256=y
CONFIG_GZIP=y
CONFIG_CMD_BOOTI=y
CONFIG_SYS_BOOTM_LEN=0x8000000
CONFIG_SAVE_PREV_BL_INITRAMFS_START_ADDR=y
CONFIG_SAVE_PREV_BL_FDT_ADDR=y
CONFIG_PANIC_HANG=y
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
# CONFIG_BUTTON_CMD is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_FASTBOOT_FLASH is not set
# CONFIG_CMD_USB_MASS_STORAGE is not set
# CONFIG_CMD_DFU is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set
