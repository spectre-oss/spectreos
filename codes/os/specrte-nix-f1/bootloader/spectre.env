# Wait forever: no timed boot, boot scanning, or persistent environment writes.
bootdelay=-1
bootretry=-1
# Netconsole starts in preboot, after board_late_init registers USB Ethernet.
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole
ipaddr=172.16.42.1
serverip=172.16.42.2
netmask=255.255.255.0
ncip=172.16.42.2
ncinport=6666
ncoutport=6666
ethact=usb_ether
ethprime=usb_ether
ethrotate=no
autoload=no
netretry=no
bootcmd=echo Waiting for an explicit USB host command
# The FIT is supplied as the Android ramdisk by Xiaomi's original bootloader.
# Keep it intact; replacements are received into a separate allocated buffer.
preboot=setenv stdin serial,nc; setenv stdout serial,vidconsole,nc; setenv stderr serial,vidconsole,nc; echo SPECTRE USB BOOT CONTROL; echo USB console configured for 172.16.42.1 UDP 6666; echo Host connection must be verified; echo Use run spectre_continue to boot the bundled Linux image
spectre_continue=if test -n ${prevbl_initrd_start_addr}; then iminfo ${prevbl_initrd_start_addr} && bootm ${prevbl_initrd_start_addr}; else echo ERROR: bundled Linux FIT was not passed by the previous bootloader; fi
spectre_replace=tftpboot ${loadaddr} spectre.itb && iminfo ${loadaddr} && bootm ${loadaddr}
spectre_help=echo run spectre_continue - boot bundled Linux; echo run spectre_replace - fetch spectre.itb from host and boot; echo reset - restart into USB waiting mode
