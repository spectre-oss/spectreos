<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
 <TextView android:text="Negative coordinates clip at the edge" android:layout_width="match_parent" android:layout_height="28dp"/>
 <AbsoluteLayout android:layout_width="match_parent" android:layout_height="120dp" android:padding="12dp" android:background="#E3ECE4">
  <TextView android:text="At -8, -8" android:layout_x="-8dp" android:layout_y="-8dp" android:padding="8dp" android:background="#C5E3CC" android:layout_width="120dp" android:layout_height="48dp"/>
  <TextView android:text="At 60, 52" android:layout_x="60dp" android:layout_y="52dp" android:padding="8dp" android:background="#D9CCEF" android:layout_width="140dp" android:layout_height="48dp"/>
 </AbsoluteLayout>
 <TextView android:text="wrap_content ignores gone children" android:layout_width="match_parent" android:layout_height="28dp"/>
 <AbsoluteLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:background="#E3ECE4">
  <TextView android:text="Visible" android:layout_x="20dp" android:layout_y="16dp" android:background="#D9CCEF" android:layout_width="110dp" android:layout_height="40dp"/>
  <TextView android:text="Gone" android:visibility="gone" android:layout_x="250dp" android:layout_y="100dp" android:layout_width="100dp" android:layout_height="40dp"/>
 </AbsoluteLayout>
</LinearLayout>
