<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TextView android:text="cropToPadding false" android:layout_width="match_parent" android:layout_height="28dp"/>
  <ImageView android:id="crop_padding_off" android:src="@drawable/switcher_day" android:scaleType="centerCrop" android:cropToPadding="false" android:padding="20dp" android:background="#e39b16" android:layout_width="120dp" android:layout_height="100dp"/>
  <TextView android:text="cropToPadding true" android:layout_width="match_parent" android:layout_height="28dp"/>
  <ImageView android:id="crop_padding_on" android:src="@drawable/switcher_day" android:scaleType="centerCrop" android:cropToPadding="true" android:padding="20dp" android:background="#e39b16" android:layout_width="120dp" android:layout_height="100dp"/>
</LinearLayout>
