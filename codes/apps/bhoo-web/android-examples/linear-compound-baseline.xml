<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="72dp">
    <CheckBox android:id="baseline_box" android:text="Check" android:textSize="16sp" android:layout_width="120dp" android:layout_height="48dp"/>
    <TextView android:text="Large" android:textSize="32sp" android:layout_width="120dp" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="72dp">
    <RadioButton android:id="baseline_radio" android:text="Radio" android:textSize="16sp" android:layout_width="120dp" android:layout_height="48dp"/>
    <TextView android:text="Large" android:textSize="32sp" android:layout_width="120dp" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="72dp">
    <Switch android:id="baseline_switch" android:text="Switch" android:textSize="16sp" android:layout_width="120dp" android:layout_height="48dp"/>
    <TextView android:text="Large" android:textSize="32sp" android:layout_width="120dp" android:layout_height="wrap_content"/>
  </LinearLayout>
</LinearLayout>
