<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="72dp">
    <EditText android:id="baseline_edit" android:text="Edit" android:layout_width="120dp" android:layout_height="48dp"/>
    <TextView android:text="Large" android:textSize="32sp" android:layout_width="120dp" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="72dp">
    <AutoCompleteTextView android:id="baseline_auto" android:text="Auto" android:layout_width="120dp" android:layout_height="48dp"/>
    <TextView android:text="Large" android:textSize="32sp" android:layout_width="120dp" android:layout_height="wrap_content"/>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="72dp">
    <MultiAutoCompleteTextView android:id="baseline_multi" android:text="Multi" android:layout_width="120dp" android:layout_height="48dp"/>
    <TextView android:text="Large" android:textSize="32sp" android:layout_width="120dp" android:layout_height="wrap_content"/>
  </LinearLayout>
</LinearLayout>
