<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="relative_demo" android:clipChildren="false" android:layout_width="match_parent" android:layout_height="400dp" android:padding="16dp" android:background="#E3ECE4">
  <TextView android:id="detail" android:text="Details follow the title." android:layout_width="190dp" android:layout_height="40dp" android:layout_below="@id/title" android:layout_alignStart="@id/title" android:layout_alignWithParentIfMissing="true" android:layout_marginTop="8dp"/>
  <Button android:id="done" android:text="Done" android:layout_width="80dp" android:layout_height="48dp" android:layout_alignParentEnd="true" android:layout_alignParentBottom="true"/>
  <TextView android:id="title" android:text="Project title" android:textStyle="bold" android:textSize="24sp" android:layout_width="180dp" android:layout_height="40dp" android:layout_alignParentStart="true" android:layout_alignParentTop="true"/>
  <Button android:id="edit" android:text="Edit" android:layout_width="70dp" android:layout_height="40dp" android:layout_toEndOf="@id/title" android:layout_alignBaseline="@id/title" android:layout_marginStart="8dp"/>
  <View android:id="divider" android:background="#AABDB0" android:layout_width="match_parent" android:layout_height="1dp" android:layout_below="@id/detail" android:layout_alignParentStart="true" android:layout_alignParentEnd="true" android:layout_marginTop="8dp"/>
  <RelativeLayout android:id="gravity_demo" android:layout_width="match_parent" android:layout_height="50dp" android:layout_below="@id/divider" android:layout_marginTop="8dp" android:background="#D0DED1" android:gravity="center" android:ignoreGravity="@id/gravity_fixed">
    <TextView android:id="gravity_fixed" android:text="Pinned" android:layout_width="55dp" android:layout_height="24dp"/>
    <TextView android:id="gravity_first" android:text="Centered" android:layout_width="75dp" android:layout_height="24dp"/>
    <TextView android:id="gravity_second" android:text="group" android:layout_width="55dp" android:layout_height="24dp" android:layout_toEndOf="@id/gravity_first"/>
  </RelativeLayout>
  <RelativeLayout android:id="wrap_demo" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_below="@id/gravity_demo" android:layout_marginTop="8dp" android:paddingLeft="80dp" android:paddingTop="12dp" android:background="#C1D4C5">
    <TextView android:id="centered_in_parent" android:text="Centered" android:layout_width="80dp" android:layout_height="24dp" android:layout_centerInParent="true" android:background="#9DBDA5"/>
  </RelativeLayout>
  <RelativeLayout android:id="direction_demo" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_below="@id/wrap_demo" android:layout_marginTop="8dp" android:layoutDirection="rtl" android:background="#D0DED1">
    <TextView android:id="direction_anchor" android:text="RTL" android:layout_width="55dp" android:layout_height="24dp" android:layout_alignParentStart="true" android:background="#9DBDA5"/>
    <TextView android:id="direction_text" android:text="Nested RTL" android:layout_width="100dp" android:layout_height="wrap_content" android:layout_toEndOf="@id/direction_anchor"/>
  </RelativeLayout>
  <RelativeLayout android:id="overflow_demo" android:layout_width="120dp" android:layout_height="48dp" android:layout_below="@id/direction_demo" android:layout_marginTop="8dp" android:clipChildren="false" android:clipToPadding="false" android:background="#D0DED1">
    <TextView android:id="overflow_anchor" android:text="Parent edge →" android:layout_width="120dp" android:layout_height="24dp"/>
    <TextView android:id="overflow_label" android:text="Overflow" android:layout_width="80dp" android:layout_height="24dp" android:layout_toRightOf="@id/overflow_anchor" android:layout_marginLeft="8dp" android:background="#9DBDA5"/>
  </RelativeLayout>
</RelativeLayout>
