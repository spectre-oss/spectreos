<TableLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content">
  <TableRow android:layout_width="match_parent" android:layout_height="48dp">
    <Button android:id="table_wrap" android:text="Short" android:paddingHorizontal="12dp" android:background="#e8def8" android:layout_width="wrap_content" android:layout_height="48dp"/>
    <Button android:id="table_next" android:text="Next" android:background="#d9e8de" android:layout_width="56dp" android:layout_height="48dp"/>
  </TableRow>
  <TableRow android:layout_width="match_parent" android:layout_height="48dp">
    <Button android:id="table_small" android:text="One" android:background="#e8def8" android:layout_width="wrap_content" android:layout_height="48dp"/>
    <Button android:id="table_second" android:text="Two" android:background="#d9e8de" android:layout_width="56dp" android:layout_height="48dp"/>
  </TableRow>
</TableLayout>
