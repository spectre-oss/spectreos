<GridLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="grid" android:useDefaultMargins="true" android:orientation="horizontal" android:columnCount="2" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="#E3ECE4">
  <Button android:id="one" android:text="One" android:layout_width="100dp" android:layout_height="48dp"/>
  <Button android:id="two" android:layout_marginStart="0dp" android:layout_columnWeight="1" android:text="Two" android:layout_width="0dp" android:layout_height="48dp"/>
  <Button android:id="three" android:layout_row="1" android:layout_column="1" android:layout_gravity="end" android:text="Three" android:layout_width="60dp" android:layout_height="48dp"/>
  <Button android:id="four" android:text="Four" android:layout_width="100dp" android:layout_height="48dp"/>
  <Button android:id="five" android:layout_columnSpan="2" android:text="Five spans two columns" android:layout_width="208dp" android:layout_height="48dp"/>
  <Button android:id="six" android:text="Six" android:layout_width="100dp" android:layout_height="48dp"/>
  <TextView android:id="grid_small" android:text="Small" android:textSize="16sp" android:layout_row="5" android:layout_column="0" android:layout_width="100dp" android:layout_height="wrap_content"/>
  <TextView android:id="grid_large" android:text="Large" android:textSize="24sp" android:layout_row="5" android:layout_column="1" android:layout_gravity="baseline" android:layout_width="100dp" android:layout_height="wrap_content"/>
</GridLayout>
