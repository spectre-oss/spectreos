<TableLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="table" android:stretchColumns="1" android:shrinkColumns="*" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="#E3ECE4">
  <TableRow android:background="#C1D4C5">
    <Button android:id="name" android:text="Name" android:layout_width="110dp" android:layout_height="48dp"/>
    <Button android:id="status" android:layout_gravity="end" android:text="Status" android:layout_width="90dp" android:layout_height="48dp"/>
  </TableRow>
  <TableRow>
    <Button android:id="alice" android:text="Alice" android:layout_width="70dp" android:layout_height="48dp"/>
    <Button android:id="active" android:text="Active" android:layout_width="110dp" android:layout_height="48dp"/>
  </TableRow>
  <TableRow android:id="bob_row" android:layoutDirection="rtl" android:alpha="0.65" android:background="#D0DED1">
    <Button android:id="bob" android:text="Bob" android:layout_width="90dp" android:layout_height="72dp"/>
    <Button android:id="away" android:layout_gravity="bottom" android:text="Away" android:layout_width="80dp" android:layout_height="40dp"/>
  </TableRow>
  <TableRow android:background="#D0DED1">
    <Button android:id="summary" android:text="Both columns" android:layout_span="2" android:layout_width="200dp" android:layout_height="48dp"/>
  </TableRow>
  <TableRow>
    <Button android:id="second_only" android:text="Second only" android:layout_column="1" android:layout_width="110dp" android:layout_height="48dp"/>
  </TableRow>
  <TableRow android:background="#D0DED1">
    <TextView android:id="small_baseline" android:text="Small" android:textSize="16sp" android:layout_width="110dp" android:layout_height="wrap_content"/>
    <TextView android:id="large_baseline" android:text="Large" android:textSize="24sp" android:layout_width="110dp" android:layout_height="wrap_content"/>
  </TableRow>
  <TableRow android:background="#D0DED1">
    <Button android:id="tall_cell" android:text="Tall" android:layout_width="110dp" android:layout_height="72dp"/>
    <Button android:id="fill_cell" android:text="Fill height" android:layout_width="110dp" android:layout_height="match_parent"/>
  </TableRow>
</TableLayout>
