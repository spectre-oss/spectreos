<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
 <TextView android:text="Baseline aligned (default)" android:layout_width="match_parent" android:layout_height="28dp" />
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="64dp" android:background="#E1EDE0">
  <TextView android:text="Small" android:textSize="16sp" android:layout_width="96dp" android:layout_height="wrap_content" android:background="#D3E5D2" />
  <TextView android:text="Large" android:textSize="32sp" android:layout_width="110dp" android:layout_height="wrap_content" android:background="#E6D7ED" />
 </LinearLayout>
 <TextView android:text="Baseline alignment disabled" android:layout_width="match_parent" android:layout_height="28dp" />
 <LinearLayout android:orientation="horizontal" android:baselineAligned="false" android:layout_width="match_parent" android:layout_height="64dp" android:background="#E1EDE0">
  <TextView android:text="Small" android:textSize="16sp" android:layout_width="96dp" android:layout_height="wrap_content" android:background="#D3E5D2" />
  <TextView android:text="Large" android:textSize="32sp" android:layout_width="110dp" android:layout_height="wrap_content" android:background="#E6D7ED" />
 </LinearLayout>
</LinearLayout>
