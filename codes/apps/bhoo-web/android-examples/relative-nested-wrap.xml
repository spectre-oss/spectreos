<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="56dp">
  <RelativeLayout android:id="nested_relative" android:layout_width="wrap_content" android:layout_height="48dp">
    <Button android:id="nested_relative_label" android:text="Small" android:paddingHorizontal="12dp" android:background="#e8def8" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_alignParentStart="true"/>
    <Button android:id="nested_relative_next" android:text="More" android:background="#d9e8de" android:layout_width="56dp" android:layout_height="48dp" android:layout_toEndOf="@id/nested_relative_label"/>
