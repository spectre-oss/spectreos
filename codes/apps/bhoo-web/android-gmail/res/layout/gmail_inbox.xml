<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gmail_surface">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/inbox_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gmail_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top Elevated White Search Pill -->
            <LinearLayout
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/search_pill"
                android:clickable="true"
                android:contentDescription="@string/search_in_mail"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="10dp">

                <ImageButton
                    android:id="@+id/menu_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:contentDescription="@string/cd_open_drawer"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingStart="6dp"
                    android:paddingEnd="8dp"
                    android:singleLine="true"
                    android:text="@string/search_in_mail"
                    android:textColor="@color/gmail_muted"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/account_avatar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/avatar_account"
                    android:clickable="true"
                    android:contentDescription="Account profile"
                    android:gravity="center"
                    android:text="@string/account_initial"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tab Content Area -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Mail Tab: SwipeRefreshLayout + ScrollView -->
                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/inbox_swipe_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ScrollView
                        android:id="@+id/inbox_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="76dp">

                            <!-- Preload filled star vector so runtime star toggle can swap drawables -->
                            <ImageView
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:src="@drawable/ic_star_filled"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/section_header"
                                style="@style/Gmail.Text.SectionHeader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="6dp"
                                android:paddingBottom="4dp"
                                android:text="@string/section_primary" />

                            <!-- Row 0: Sam (with photo attachment chip +1) -->
                            <LinearLayout
                                android:id="@+id/email_row_0"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_0_sender"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Gmail.AvatarText"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@drawable/avatar_sam"
                                        android:text="@string/email_0_initial" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/Gmail.Text.SenderUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/email_0_sender" />

                                        <TextView
                                            style="@style/Gmail.Text.SubjectUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_0_subject" />

                                        <TextView
                                            style="@style/Gmail.Text.Snippet"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_0_snippet" />

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="8dp"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <LinearLayout
                                                android:layout_width="wrap_content"
                                                android:layout_height="28dp"
                                                android:background="@drawable/attachment_chip"
                                                android:gravity="center_vertical"
                                                android:orientation="horizontal"
                                                android:paddingStart="10dp"
                                                android:paddingEnd="12dp">

                                                <ImageView
                                                    android:layout_width="16dp"
                                                    android:layout_height="16dp"
                                                    android:layout_marginEnd="6dp"
                                                    android:src="@drawable/ic_image" />

                                                <TextView
                                                    android:layout_width="wrap_content"
                                                    android:layout_height="wrap_content"
                                                    android:singleLine="true"
                                                    android:text="@string/email_0_attachment"
                                                    android:textColor="@color/gmail_muted"
                                                    android:textSize="12.5sp" />
                                            </LinearLayout>

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="8dp"
                                                android:text="@string/email_0_attachment_more"
                                                android:textColor="@color/gmail_muted"
                                                android:textSize="12.5sp"
                                                android:textStyle="bold" />
                                        </LinearLayout>
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.TimeUnread"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/email_0_time" />

                                    <ImageButton
                                        android:id="@+id/star_0"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="4dp"
                                        android:padding="8dp"
                                        android:contentDescription="@string/cd_star_message"
                                        android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 1: Promotions (with 4 new green pill) -->
                            <LinearLayout
                                android:id="@+id/email_row_1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_1_sender"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <FrameLayout
                                    android:layout_width="40dp"
                                    android:layout_height="40dp">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_sell" />
                                </FrameLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.SenderUnread"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:text="@string/email_1_sender" />

                                    <TextView
                                        style="@style/Gmail.Text.Snippet"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/email_1_subject" />
                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="22dp"
                                    android:background="@drawable/promo_badge"
                                    android:gravity="center"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="10dp"
                                    android:text="@string/email_1_badge"
                                    android:textColor="@color/white"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Row 2: Square (read) -->
                            <LinearLayout
                                android:id="@+id/email_row_2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_2_sender"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Gmail.AvatarText"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@drawable/avatar_square"
                                        android:text="@string/email_2_initial" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/Gmail.Text.SenderRead"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/email_2_sender" />

                                        <TextView
                                            style="@style/Gmail.Text.SubjectRead"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_2_subject" />

                                        <TextView
                                            style="@style/Gmail.Text.Snippet"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_2_snippet" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.TimeRead"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/email_2_time" />

                                    <ImageButton
                                        android:id="@+id/star_2"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="4dp"
                                        android:padding="8dp"
                                        android:contentDescription="@string/cd_star_message"
                                        android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 3: Under Armour (person silhouette avatar) -->
                            <LinearLayout
                                android:id="@+id/email_row_3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_3_sender"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <FrameLayout
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@drawable/avatar_ua">

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:layout_gravity="center"
                                            android:src="@drawable/ic_person" />
                                    </FrameLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/Gmail.Text.SenderUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/email_3_sender" />

                                        <TextView
                                            style="@style/Gmail.Text.SubjectUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_3_subject" />

                                        <TextView
                                            style="@style/Gmail.Text.Snippet"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_3_snippet" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.TimeUnread"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/email_3_time" />

                                    <ImageButton
                                        android:id="@+id/star_3"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="4dp"
                                        android:padding="8dp"
                                        android:contentDescription="@string/cd_star_message"
                                        android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 4: Pinterest -->
                            <LinearLayout
                                android:id="@+id/email_row_4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_4_sender"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Gmail.AvatarText"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@drawable/avatar_pinterest"
                                        android:text="@string/email_4_initial" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/Gmail.Text.SenderUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/email_4_sender" />

                                        <TextView
                                            style="@style/Gmail.Text.SubjectUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_4_subject" />

                                        <TextView
                                            style="@style/Gmail.Text.Snippet"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_4_snippet" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.TimeUnread"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/email_4_time" />

                                    <ImageButton
                                        android:id="@+id/star_4"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="4dp"
                                        android:padding="8dp"
                                        android:contentDescription="@string/cd_star_message"
                                        android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 5: Vercel -->
                            <LinearLayout
                                android:id="@+id/email_row_5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_5_sender"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Gmail.AvatarText"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@drawable/avatar_vercel"
                                        android:text="@string/email_5_initial" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/Gmail.Text.SenderUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/email_5_sender" />

                                        <TextView
                                            style="@style/Gmail.Text.SubjectUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_5_subject" />

                                        <TextView
                                            style="@style/Gmail.Text.Snippet"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_5_snippet" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.TimeUnread"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/email_5_time" />

                                    <ImageButton
                                        android:id="@+id/star_5"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="4dp"
                                        android:padding="8dp"
                                        android:contentDescription="@string/cd_star_message"
                                        android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Row 6: Google One -->
                            <LinearLayout
                                android:id="@+id/email_row_6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/email_6_sender"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="9dp"
                                android:paddingBottom="9dp">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="horizontal">

                                    <TextView
                                        style="@style/Gmail.AvatarText"
                                        android:layout_width="40dp"
                                        android:layout_height="40dp"
                                        android:layout_marginTop="2dp"
                                        android:background="@drawable/avatar_google"
                                        android:text="@string/email_6_initial" />

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="14dp"
                                        android:layout_marginEnd="8dp"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            style="@style/Gmail.Text.SenderUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:text="@string/email_6_sender" />

                                        <TextView
                                            style="@style/Gmail.Text.SubjectUnread"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_6_subject" />

                                        <TextView
                                            style="@style/Gmail.Text.Snippet"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="@string/email_6_snippet" />
                                    </LinearLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="end"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Gmail.Text.TimeUnread"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="8dp"
                                        android:text="@string/email_6_time" />

                                    <ImageButton
                                        android:id="@+id/star_6"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginTop="4dp"
                                        android:padding="8dp"
                                        android:contentDescription="@string/cd_star_message"
                                        android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

                <!-- Chat Tab View -->
                <LinearLayout
                    android:id="@+id/tab_chat_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48dp"
                        android:text="@string/chat_title"
                        android:textColor="@color/gmail_ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:text="@string/chat_subtitle"
                        android:textColor="@color/gmail_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Meet Tab View -->
                <LinearLayout
                    android:id="@+id/tab_meet_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="48dp"
                        android:text="@string/meet_title"
                        android:textColor="@color/gmail_ink"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_horizontal"
                        android:text="@string/meet_subtitle"
                        android:textColor="@color/gmail_muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:dividerColor="@color/gmail_divider" />

            <!-- Material 3 BottomNavigationView with 99+ badge on Mail -->
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@color/white"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/gmail_nav" />
        </LinearLayout>

        <!-- Floating Compose ExtendedFloatingActionButton -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_compose"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="92dp"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:src="@drawable/edit"
            android:text="@string/compose"
            android:textColor="@color/gmail_red"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/white"
            app:cornerRadius="28dp"
            app:elevation="6dp"
            app:extended="true" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Material 3 NavigationView Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/gmail_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
