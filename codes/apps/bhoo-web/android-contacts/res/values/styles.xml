<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Contacts.ToolbarTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Contacts.PopupItem">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/contacts_ink</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Contacts.DialogTitle">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/contacts_ink</item>
    </style>

    <style name="Contacts.DialogAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/contacts_primary</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Contacts.PrefTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/contacts_ink</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Contacts.PrefSummary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/contacts_muted</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Contacts.EditorField">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/contacts_ink</item>
        <item name="android:textColorHint">@color/contacts_hint</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
