<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contacts_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Settings Top Toolbar -->
        <LinearLayout
            android:id="@+id/settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/contacts_primary"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/settings_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_navigate_up"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back_white" />

            <TextView
                android:id="@+id/settings_title"
                style="@style/Contacts.ToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_title" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settings_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Preload alternate toolbar arrow drawables -->
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_arrow_back_white"
                    android:visibility="gone" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_arrow_back_dark"
                    android:visibility="gone" />

                <!-- 1. Main Settings Preference List -->
                <LinearLayout
                    android:id="@+id/settings_main_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp">

                    <LinearLayout
                        android:id="@+id/pref_my_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_my_info" />

                        <TextView
                            android:id="@+id/pref_my_info_sub"
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/drawer_my_info_sub" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_accounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_accounts" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_default_account"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_default_account" />

                        <TextView
                            android:id="@+id/pref_default_account_sub"
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/editor_device" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_contacts_to_display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_contacts_to_display" />

                        <TextView
                            android:id="@+id/pref_display_sub"
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pref_all_contacts" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_sort_by"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_sort_by" />

                        <TextView
                            android:id="@+id/pref_sort_sub"
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pref_first_name" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_name_format"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_name_format" />

                        <TextView
                            android:id="@+id/pref_name_format_sub"
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pref_first_name_first" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_phonetic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_phonetic" />

                        <TextView
                            android:id="@+id/pref_phonetic_sub"
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pref_hide_if_empty" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_import"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_import" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_export"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_export" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_blocked"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_blocked" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pref_about"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/pref_about" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. About Contacts Subscreen -->
                <LinearLayout
                    android:id="@+id/settings_about_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/about_version"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_build_version" />

                        <TextView
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_version_num" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/contacts_divider" />

                    <LinearLayout
                        android:id="@+id/about_licenses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="68dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_open_source" />

                        <TextView
                            style="@style/Contacts.PrefSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_open_source_sub" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/contacts_divider" />

                    <LinearLayout
                        android:id="@+id/about_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_privacy" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/contacts_divider" />

                    <LinearLayout
                        android:id="@+id/about_terms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:minHeight="56dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_terms" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/contacts_divider" />
                </LinearLayout>

                <!-- 3. Emergency Information Subscreen -->
                <LinearLayout
                    android:id="@+id/settings_emergency_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="68dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:text="@string/emerg_medical_header"
                        android:textColor="@color/contacts_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/emerg_name_row"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:clickable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_emergency_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="24dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Contacts.PrefTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/emerg_name" />

                            <TextView
                                android:id="@+id/emerg_owner_name"
                                style="@style/Contacts.PrefSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/emerg_owner" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/emerg_add_info"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_add_dark" />

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="26dp"
                            android:layout_weight="1"
                            android:text="@string/emerg_add_info" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/emerg_info_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="68dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:text=""
                        android:textColor="@color/contacts_muted"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/contacts_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="68dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:text="@string/emerg_contacts_header"
                        android:textColor="@color/contacts_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/emerg_add_contact"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_add_dark" />

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="26dp"
                            android:layout_weight="1"
                            android:text="@string/emerg_add_contact" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/emerg_contacts_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="68dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp"
                        android:text=""
                        android:textColor="@color/contacts_muted"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/contacts_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_info_dark" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/emerg_disclaimer_1"
                            android:textColor="@color/contacts_muted"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/emerg_disclaimer_2"
                            android:textColor="@color/contacts_muted"
                            android:textSize="14.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. Blocked Numbers Subscreen -->
                <LinearLayout
                    android:id="@+id/settings_blocked_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Contacts.PrefTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/blocked_unknown" />

                            <TextView
                                style="@style/Contacts.PrefSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/blocked_unknown_sub" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/blocked_unknown_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="20dp"
                        android:text="@string/blocked_explanation"
                        android:textColor="@color/contacts_ink"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/blocked_add_number"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:clickable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_add_dark" />

                        <TextView
                            style="@style/Contacts.PrefTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/blocked_add_number" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/blocked_list_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:text=""
                        android:textColor="@color/contacts_muted"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Settings Radio Choice Dialog Overlay -->
    <FrameLayout
        android:id="@+id/settings_dialog_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bg"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/settings_dialog_card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_card"
            android:clickable="true"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/settings_dialog_title"
                style="@style/Contacts.DialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pref_sort_by" />

            <RadioGroup
                android:id="@+id/settings_dialog_radios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/set_opt_0"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/contacts_control_tint"
                    android:checked="true"
                    android:text="@string/pref_first_name"
                    android:textColor="@color/contacts_ink"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/set_opt_1"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/contacts_control_tint"
                    android:text="@string/pref_last_name"
                    android:textColor="@color/contacts_ink"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/set_opt_2"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:buttonTint="@color/contacts_control_tint"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settings_dialog_cancel"
                    style="@style/Contacts.DialogAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/action_cancel" />

                <Button
                    android:id="@+id/settings_dialog_ok"
                    style="@style/Contacts.DialogAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_ok" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
