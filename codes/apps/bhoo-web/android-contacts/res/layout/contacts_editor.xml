<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contacts_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Editor Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/contacts_primary"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/editor_cancel"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_cancel"
                android:padding="12dp"
                android:src="@drawable/ic_close_white" />

            <TextView
                android:id="@+id/editor_title"
                style="@style/Contacts.ToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:text="@string/editor_create_title" />

            <Button
                android:id="@+id/editor_save"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/action_save"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scrollable Form Body -->
        <ScrollView
            android:id="@+id/editor_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Preload chevron toggle drawables -->
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_expand_more_muted"
                    android:visibility="gone" />
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_expand_less_muted"
                    android:visibility="gone" />

                <!-- Hero Photo Banner -->
                <FrameLayout
                    android:id="@+id/editor_photo_area"
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:background="@color/contacts_editor_hero"
                    android:clickable="true"
                    android:contentDescription="@string/cd_change_photo">

                    <ImageView
                        android:layout_width="116dp"
                        android:layout_height="116dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="4dp"
                        android:src="@drawable/ic_person_hero_white" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="14dp"
                        android:src="@drawable/ic_camera_white" />
                </FrameLayout>

                <!-- Saving to Account Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_smartphone_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/editor_saving_to"
                            android:textColor="@color/contacts_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/editor_saving_to"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/editor_device"
                            android:textColor="@color/contacts_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Structured Name Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/ic_person_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/editor_prefix_wrap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/ed_prefix"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_prefix"
                                android:inputType="textPersonName" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/ed_first_name"
                            style="@style/Contacts.EditorField"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="@string/hint_first_name"
                            android:inputType="textPersonName" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="2dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/contacts_primary" />

                        <LinearLayout
                            android:id="@+id/editor_middle_wrap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/ed_middle_name"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_middle_name"
                                android:inputType="textPersonName" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/ed_last_name"
                            style="@style/Contacts.EditorField"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="@string/hint_last_name"
                            android:inputType="textPersonName" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/contacts_underline" />

                        <LinearLayout
                            android:id="@+id/editor_suffix_wrap"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <EditText
                                android:id="@+id/ed_suffix"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_suffix"
                                android:inputType="textPersonName" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/editor_expand_name"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:contentDescription="@string/cd_expand_name"
                        android:padding="8dp"
                        android:src="@drawable/ic_expand_more_muted" />
                </LinearLayout>

                <!-- Phone Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="56dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/ic_phone_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/ed_phone"
                            style="@style/Contacts.EditorField"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="@string/hint_phone"
                            android:inputType="phone" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/contacts_underline" />

                        <LinearLayout
                            android:id="@+id/editor_phone_type_btn"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/editor_phone_type_text"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/detail_default_phone_type"
                                    android:textColor="@color/contacts_muted"
                                    android:textSize="15.5sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_dropdown_arrow_muted" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Email Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="56dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="12dp"
                        android:src="@drawable/ic_mail_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <EditText
                            android:id="@+id/ed_email"
                            style="@style/Contacts.EditorField"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:hint="@string/hint_email"
                            android:inputType="textEmailAddress" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="8dp"
                            android:background="@color/contacts_underline" />

                        <LinearLayout
                            android:id="@+id/editor_email_type_btn"
                            android:layout_width="140dp"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/editor_email_type_text"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/detail_default_email_type"
                                    android:textColor="@color/contacts_muted"
                                    android:textSize="15.5sp" />

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_dropdown_arrow_muted" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Extra More Fields Section -->
                <LinearLayout
                    android:id="@+id/editor_extra_fields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone">

                    <!-- Organization Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="56dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_business_muted" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/ed_org"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_company"
                                android:inputType="textCapWords" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginBottom="8dp"
                                android:background="@color/contacts_underline" />

                            <EditText
                                android:id="@+id/ed_title"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_title"
                                android:inputType="textCapWords" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Address Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="56dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_location_muted" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/ed_address"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_address"
                                android:inputType="textPostalAddress" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Notes Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="56dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginTop="12dp"
                            android:src="@drawable/ic_notes_muted" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="28dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <EditText
                                android:id="@+id/ed_notes"
                                style="@style/Contacts.EditorField"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:hint="@string/hint_notes"
                                android:inputType="textCapSentences" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="@color/contacts_underline" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- More Fields Toggle -->
                <TextView
                    android:id="@+id/editor_more_fields_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:padding="8dp"
                    android:text="@string/editor_more_fields"
                    android:textColor="@color/contacts_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Editor Modal Dialog Overlay (Change photo / Type picker / Discard) -->
    <FrameLayout
        android:id="@+id/editor_dialog_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bg"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/editor_dialog_card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_card"
            android:clickable="true"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/editor_dialog_title"
                style="@style/Contacts.DialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/editor_change_photo" />

            <LinearLayout
                android:id="@+id/editor_dialog_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ed_opt_0"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_3"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_4"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_5"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_6"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_7"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/ed_opt_8"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editor_dialog_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/editor_dialog_cancel"
                    style="@style/Contacts.DialogAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/action_cancel" />

                <Button
                    android:id="@+id/editor_dialog_confirm"
                    style="@style/Contacts.DialogAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_discard"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
