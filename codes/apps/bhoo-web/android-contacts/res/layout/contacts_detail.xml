<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/contacts_detail_bg">

    <ScrollView
        android:id="@+id/detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Preload runtime-swapped hero backgrounds and star icons -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/hero_bg_0"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/hero_bg_1"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/hero_bg_2"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/hero_bg_3"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/hero_bg_4"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/hero_bg_5"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_star_filled_white"
                android:visibility="gone" />
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:src="@drawable/ic_star_outline_white"
                android:visibility="gone" />

            <!-- Contact Hero Header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <ImageView
                    android:id="@+id/detail_hero_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:src="@drawable/hero_bg_0" />

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person_hero_white" />

                <!-- Overlay Top App Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_gravity="top"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <ImageButton
                        android:id="@+id/detail_back"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_navigate_up"
                        android:padding="12dp"
                        android:src="@drawable/ic_arrow_back_white" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/detail_star"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_star"
                        android:padding="12dp"
                        android:src="@drawable/ic_star_outline_white" />

                    <ImageButton
                        android:id="@+id/detail_edit"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_edit"
                        android:padding="12dp"
                        android:src="@drawable/ic_edit_white" />

                    <ImageButton
                        android:id="@+id/detail_more"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/cd_more_options"
                        android:padding="12dp"
                        android:src="@drawable/ic_more_vert_white" />
                </LinearLayout>

                <!-- Contact Display Name -->
                <TextView
                    android:id="@+id/detail_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="16dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/detail_default_name"
                    android:textColor="@color/white"
                    android:textSize="28sp" />
            </FrameLayout>

            <!-- Communication Card (Phone / SMS / Email) -->
            <LinearLayout
                android:id="@+id/detail_comm_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/detail_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/detail_phone_row"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_phone_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_phone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/detail_default_phone"
                            android:textColor="@color/contacts_ink"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/detail_phone_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:singleLine="true"
                            android:text="@string/detail_default_phone_type"
                            android:textColor="@color/contacts_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/detail_sms"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="@string/cd_sms"
                        android:padding="10dp"
                        android:src="@drawable/ic_sms_muted" />
                </LinearLayout>

                <View
                    android:id="@+id/detail_comm_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="64dp"
                    android:layout_marginEnd="16dp"
                    android:background="@color/contacts_divider" />

                <LinearLayout
                    android:id="@+id/detail_email_row"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_mail_muted" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/detail_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/detail_default_email"
                            android:textColor="@color/contacts_ink"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/detail_email_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:singleLine="true"
                            android:text="@string/detail_default_email_type"
                            android:textColor="@color/contacts_muted"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- About Card -->
            <LinearLayout
                android:id="@+id/detail_about_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/detail_card"
                android:elevation="2dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_about_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp"
                    android:text="@string/detail_default_about"
                    android:textColor="@color/contacts_about_header"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/contacts_divider" />

                <LinearLayout
                    android:id="@+id/detail_org_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_organization"
                        android:textColor="@color/contacts_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_org"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/detail_default_org"
                        android:textColor="@color/contacts_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detail_notes_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_notes"
                        android:textColor="@color/contacts_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/contacts_muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detail_labels_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_labels"
                        android:textColor="@color/contacts_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_labels"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/contacts_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detail_ringtone_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_ringtone"
                        android:textColor="@color/contacts_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/detail_ringtone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text=""
                        android:textColor="@color/contacts_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Contact Detail Overflow Popup Menu -->
    <LinearLayout
        android:id="@+id/detail_overflow_popup"
        android:layout_width="190dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/popup_menu_card"
        android:clickable="true"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/detail_menu_link"
            style="@style/Contacts.PopupItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:text="@string/detail_menu_link" />

        <TextView
            android:id="@+id/detail_menu_delete"
            style="@style/Contacts.PopupItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:text="@string/detail_menu_delete" />

        <TextView
            android:id="@+id/detail_menu_share"
            style="@style/Contacts.PopupItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:text="@string/detail_menu_share" />

        <TextView
            android:id="@+id/detail_menu_shortcut"
            style="@style/Contacts.PopupItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:text="@string/detail_menu_shortcut" />

        <TextView
            android:id="@+id/detail_menu_ringtone"
            style="@style/Contacts.PopupItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:text="@string/detail_menu_ringtone" />
    </LinearLayout>

    <!-- Detail Modal Dialog Overlay (Delete / Ringtone / Link) -->
    <FrameLayout
        android:id="@+id/detail_dialog_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bg"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/detail_dialog_card"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/dialog_card"
            android:clickable="true"
            android:elevation="12dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/detail_dialog_title"
                style="@style/Contacts.DialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_delete_title" />

            <TextView
                android:id="@+id/detail_dialog_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="@color/contacts_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/detail_dialog_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/detail_opt_0"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/detail_opt_1"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/detail_opt_2"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/detail_opt_3"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />

                <TextView
                    android:id="@+id/detail_opt_4"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/contacts_ink"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/detail_dialog_cancel"
                    style="@style/Contacts.DialogAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="@string/action_cancel" />

                <Button
                    android:id="@+id/detail_dialog_confirm"
                    style="@style/Contacts.DialogAction"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/action_delete" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
